# ClassCheck — required environment variables
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# All secrets are read from the environment only (no hardcoding in code).

# --- Teacher login (Sprint 1, simple auth) ---
TEACHER_EMAIL=teacher@sru.ac.th
TEACHER_PASSWORD=change-me
# HMAC key used to sign the session cookie (any long random string)
AUTH_SECRET=generate-a-long-random-string

# --- Stateless QR token (ADR2) ---
# Master secret used to derive per-session token secrets. Server-side only;
# never stored in Google Sheets. Use a long random string.
MASTER_SECRET=generate-another-long-random-string

# --- Google Sheets (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=classcheck@your-project.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines, wrapped in quotes:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=your-google-spreadsheet-id

# --- Course configuration (NOT secret; optional overrides) ---
# Sections for SIT0013, comma-separated (default: N01,N02)
COURSE_SECTIONS=N01,N02
# Human-readable course name (default: SIT0013)
# COURSE_NAME=SIT0013

# --- Optional: absolute base URL used inside the QR code ---
# If unset, it is derived from the request host.
# NEXT_PUBLIC_APP_URL=https://classcheck.example.com
